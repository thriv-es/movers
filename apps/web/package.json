{
  "name": "@movers/web",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n vite,api -c green,magenta \"pnpm dev:vite\" \"pnpm dev:api\"",
    "dev:vite": "vite",
    "dev:api": "node scripts/dev-api.mjs",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p functions",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "seed": "node scripts/seed.mjs",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name=movers",
    "deploy:prod": "pnpm build && wrangler pages deploy dist --project-name=movers --branch=main",
    "pages:tail": "wrangler pages deployment tail",
    "ship": "pnpm deploy"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.47",
    "@fluid-tailwind/tailwind-merge": "^0.0.3",
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/bowlby-one": "^5.3.0",
    "@hookform/resolvers": "^3.10.0",
    "@mantine/hooks": "^7.17.8",
    "@movers/ui": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-table": "^8.21.3",
    "ai": "^6.0.184",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "hono": "^4.12.19",
    "lucide-react": "^0.460.0",
    "posthog-js": "^1.376.0",
    "react": "18.3.1",
    "react-day-picker": "^9.14.0",
    "react-dom": "18.3.1",
    "react-error-boundary": "^4.1.2",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.76.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.15.1",
    "tailwind-merge": "^2.6.1",
    "ts-deepmerge": "^7.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260517.1",
    "@csstools/postcss-oklab-function": "^4.0.12",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^9.1.0",
    "fluid-tailwind": "^1.0.4",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.14",
    "postcss-discard-comments": "^7.0.8",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-fluid-typography": "^1.0.5",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.9",
    "wrangler": "^4.92.0"
  }
}
