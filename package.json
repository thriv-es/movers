{
  "name": "movers",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://movers.thriv.es",
  "repository": {
    "type": "git",
    "url": "https://github.com/thriv-es/movers"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev --proxy 5173 --port 8787",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name=movers",
    "deploy:prod": "pnpm build && wrangler pages deploy dist --project-name=movers --branch=main",
    "pages:tail": "wrangler pages deployment tail",
    "ship": "pnpm deploy"
  },
